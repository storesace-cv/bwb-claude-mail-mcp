# OAuth shim + admin (mcp-oauth-shim-whatsapp)
APP_MODE=whatsapp
HOST=127.0.0.1
PORT=18001
PUBLIC_URL=https://mcp-whatsapp.bwb.pt
UPSTREAM_MCP_URL=http://127.0.0.1:18000
BRIDGE_URL=http://127.0.0.1:18080
STATE_DIR=/var/lib/whatsapp-mcp
ADMIN_FILE=/var/lib/whatsapp-mcp/admin.json
OAUTH_STATE_DIR=/var/lib/whatsapp-mcp/oauth-state
JWT_PRIVATE_KEY_PATH=/var/lib/whatsapp-mcp/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/var/lib/whatsapp-mcp/jwt-public.pem
BRIDGE_TOKEN_FILE=/var/lib/whatsapp-mcp/store/.bridge-token
# Optional shared token for Claude Desktop (mcp-remote); OAuth JWT always accepted
# AUTH_TOKEN=
# UPSTREAM_BEARER_FILE=/var/lib/whatsapp-mcp/token
INJECT_UPSTREAM_BEARER=false
SESSION_SECRET=replace-with-openssl-rand-hex-32
LOG_LEVEL=info

# Bootstrap admin (only used if admin.json does not exist yet)
# Same credentials as MCP Mail Self-Hosted + Backoffice
BOOTSTRAP_ADMIN_NAME=Jorge Peixinho
BOOTSTRAP_ADMIN_EMAIL=jorge.peixinho@bwb.pt
BOOTSTRAP_ADMIN_PASSWORD=Quer1asEntrar
