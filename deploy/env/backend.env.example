# Upstream claude-mail-mcp backend
HOST=127.0.0.1
PORT=3220
PUBLIC_URL=https://mcp-mail.bwb.pt
LOG_LEVEL=info
AUTH_TOKEN=replace-with-openssl-rand-hex-32
ACCOUNTS_FILE=/var/lib/mail-mcp/accounts.json
# BWB Helpdesk ticket context (PublicBWBTicketContext)
HELPDESK_CONTEXT_URL=https://helpdesk.storesace.cv/otobo/public.pl?Action=PublicBWBTicketContext
HELPDESK_CONTEXT_TOKEN=replace-with-same-bearer-as-otobo-ZZZBWBTicketContext
