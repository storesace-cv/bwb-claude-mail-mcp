# /etc/whatsapp-mcp/a/mcp.env
WHATSAPP_MCP_TRANSPORT=http
WHATSAPP_MCP_HOST=127.0.0.1
WHATSAPP_MCP_PORT=18000
WHATSAPP_API_URL=http://127.0.0.1:18080/api
WHATSMEOW_DB_PATH=/var/lib/whatsapp-mcp/accounts/a/store/whatsapp.db
WHATSAPP_DB_PATH=/var/lib/whatsapp-mcp/accounts/a/store/messages.db
WHATSAPP_MEDIA_ROOTS=/var/lib/whatsapp-mcp/accounts/a/outbox
# WHATSAPP_BRIDGE_TOKEN=  (filled by install after bridge start)
