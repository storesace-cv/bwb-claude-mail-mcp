# Bridge env — /etc/whatsapp-mcp/bridge.env
WHATSAPP_BRIDGE_PORT=18080
WHATSMEOW_DB_PATH=/var/lib/whatsapp-mcp/store/whatsapp.db
WHATSAPP_DB_PATH=/var/lib/whatsapp-mcp/store/messages.db
WEBHOOK_ENABLED=false
FORWARD_SELF=false
WHATSAPP_MEDIA_ROOTS=/var/lib/whatsapp-mcp/outbox
WHATSAPP_DEVICE_NAME=BWB MCP WhatsApp
# WHATSAPP_BRIDGE_TOKEN is auto-generated next to WHATSMEOW_DB_PATH as .bridge-token
