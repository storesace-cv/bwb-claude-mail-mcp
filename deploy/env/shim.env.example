# OAuth shim + admin (mcp-oauth-shim-mail)
APP_MODE=mail
HOST=127.0.0.1
PORT=3221
PUBLIC_URL=https://mcp-mail.bwb.pt
UPSTREAM_MCP_URL=http://127.0.0.1:3220
STATE_DIR=/var/lib/mail-mcp
ACCOUNTS_FILE=/var/lib/mail-mcp/accounts.json
ADMIN_FILE=/var/lib/mail-mcp/admin.json
OAUTH_STATE_DIR=/var/lib/mail-mcp/oauth-state
JWT_PRIVATE_KEY_PATH=/var/lib/mail-mcp/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/var/lib/mail-mcp/jwt-public.pem
UPSTREAM_BEARER_FILE=/var/lib/mail-mcp/token
# AUTH_TOKEN can also be set directly (same value as upstream .env)
# AUTH_TOKEN=
SESSION_SECRET=replace-with-openssl-rand-hex-32
LOG_LEVEL=info

# Mail provider OAuth (personal Outlook.com / Gmail) — required for those account types
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Bootstrap admin (only used if admin.json does not exist yet)
BOOTSTRAP_ADMIN_NAME=Jorge Peixinho
BOOTSTRAP_ADMIN_EMAIL=jorge.peixinho@bwb.pt
BOOTSTRAP_ADMIN_PASSWORD=Quer1asEntrar
