# MCP Python env — /etc/whatsapp-mcp/mcp.env
WHATSAPP_MCP_TRANSPORT=http
WHATSAPP_MCP_HOST=127.0.0.1
WHATSAPP_MCP_PORT=18000
WHATSAPP_API_URL=http://127.0.0.1:18080/api
WHATSMEOW_DB_PATH=/var/lib/whatsapp-mcp/store/whatsapp.db
WHATSAPP_DB_PATH=/var/lib/whatsapp-mcp/store/messages.db
WHATSAPP_MEDIA_ROOTS=/var/lib/whatsapp-mcp/outbox
# Set after first bridge start (same value as store/.bridge-token):
# WHATSAPP_BRIDGE_TOKEN=
