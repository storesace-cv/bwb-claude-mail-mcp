{
  "name": "bwb-claude-mail-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "OAuth 2.1 shim + admin backoffice for self-hosted claude-mail-mcp and whatsapp-mcp",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env --enable-source-maps dist/index.js",
    "start:comms": "node --env-file=.env.comms --enable-source-maps dist/comms/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "dev:comms": "tsx --env-file=.env.comms src/comms/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/comms/mail/threads.test.ts src/comms/mail/invoices.test.ts src/comms/rules/match.test.ts src/comms/whatsapp/store.test.ts src/comms/time/lisbon.test.ts src/comms/mail/classify-promo.test.ts src/comms/mail/folders.test.ts src/comms/whatsapp/keywords.test.ts src/comms/mail/helpdesk.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "imapflow": "^1.7.1",
    "jose": "^5.10.0",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
